# ---- LLM (verify current free model IDs in AI Studio / Groq console) ----
GEMINI_API_KEY=your_google_ai_studio_key
GROQ_API_KEY=your_groq_key
PRIMARY_MODEL=gemini/gemini-2.5-flash
FALLBACK_MODEL=groq/openai/gpt-oss-120b
# OLLAMA_MODEL=ollama/qwen2.5:7b
LLM_MODE=live            # live | mock
LLM_MAX_RETRIES=2        # narrative<->validator repair rounds (HTTP retries are separate, in llm.py)
LLM_TEMPERATURE=0

# ---- Database ----
DATABASE_URL=sqlite:///data/ringsight.db
# SQL Server Express example:
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/RingSight?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# ---- App ----
ANALYST_NAME=Demo Analyst
